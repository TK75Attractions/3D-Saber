struct DakutenMap {
  const char* kana;    // UTF-8文字
  const char* base;    // 基本カタカナ
  uint8_t mark;        // 濁点(0xDE) or 半濁点(0xDF)
};

static const DakutenMap dakutenTable[] = {
  {"ガ", "カ", 0xDE}, {"ギ", "キ", 0xDE}, {"グ", "ク", 0xDE}, {"ゲ", "ケ", 0xDE}, {"ゴ", "コ", 0xDE},
  {"ザ", "サ", 0xDE}, {"ジ", "シ", 0xDE}, {"ズ", "ス", 0xDE}, {"ゼ", "セ", 0xDE}, {"ゾ", "ソ", 0xDE},
