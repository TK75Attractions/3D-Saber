  {"パ", "ハ", 0xDF}, {"ピ", "ヒ", 0xDF}, {"プ", "フ", 0xDF}, {"ペ", "ヘ", 0xDF}, {"ポ", "ホ", 0xDF},
};

void writeData(byte t_data, byte dev) {
  byte add = adress[dev];
  Wire.beginTransmission(add);
  Wire.write(0x40);
  Wire.write(t_data);
  Wire.endTransmission();
  delay(10);
}

void writeString(const char* str, byte dev) {
  while (*str) {
    bool matched = false;

    // ====== まず「濁点・半濁点つき文字」を分解 ======
    // まず濁点つき文字をチェック
    for (int i = 0; i < sizeof(dakutenTable) / sizeof(dakutenTable[0]); i++) {
      size_t len = strlen(dakutenTable[i].kana);
      if (strncmp(str, dakutenTable[i].kana, len) == 0) {
        // ベースカタカナをまず送信
        for (int j = 0; j < sizeof(kanaTable) / sizeof(kanaTable[0]); j++) {
          if (strcmp(kanaTable[j].kana, dakutenTable[i].base) == 0) {
            writeData(kanaTable[j].code, dev);
            break;
          }
        }
        // 濁点 or 半濁点を追加送信
        writeData(dakutenTable[i].mark, dev);
        str += len; // 次の文字へ
        matched = true;
        break;
      }
    }

    if (matched) continue; // 変換済みならスキップ

    // ====== 通常カタカナ ======
    for (int i = 0; i < sizeof(kanaTable) / sizeof(kanaTable[0]); i++) {
      size_t len = strlen(kanaTable[i].kana);
      if (strncmp(str, kanaTable[i].kana, len) == 0) {
        writeData(kanaTable[i].code, dev);
        str += len;
        matched = true;
        break;
      }
    }

    // ====== ASCIIなど ======
    if (!matched) {
      if ((unsigned char)*str >= 0x20 && (unsigned char)*str <= 0x7F) {
        writeData(*str, dev);
      }
      str++;
    }
  }
}

